# ==============================================================================
# Agent Fleet Explorer - Environment Configuration (.env.example)
#
# Copy this file to .env and adjust variables to suit your environment:
#   cp .env.example .env
#
# All variables start with the AGENT_FLEET_ prefix. Environment variables
# passed via your shell take precedence over values defined in .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration
# ------------------------------------------------------------------------------
# Host interface to bind the FastAPI backend server (default: 127.0.0.1)
AGENT_FLEET_HOST=127.0.0.1

# HTTP port for the FastAPI backend server (default: 8000)
AGENT_FLEET_PORT=8000

# ------------------------------------------------------------------------------
# 2. Storage & Inventory Paths
# ------------------------------------------------------------------------------
# Runtime data directory where SQLite database, quota tokens, and logs are stored.
AGENT_FLEET_DATA_DIR=data

# Inventory sources for host discovery. Supports comma-separated paths or JSON list.
# Relative paths resolve against the repository root.
AGENT_FLEET_INVENTORY_PATHS=data/inventory.yaml,inventory.yaml

# ------------------------------------------------------------------------------
# 3. Security & Access Control
# ------------------------------------------------------------------------------
# Optional bearer authentication secret / token for API protection.
# Leave empty to disable authentication (recommended for local loopback development).
AGENT_FLEET_API_SECRET=

# When AGENT_FLEET_API_SECRET is configured:
#   true  -> Read-only queries (GET) remain public; write operations require auth.
#   false -> Strict mode: all endpoints (read & write) require valid auth secret.
AGENT_FLEET_ALLOW_ANONYMOUS_READONLY=true

# ------------------------------------------------------------------------------
# 4. Scanning & SSH Engine
# ------------------------------------------------------------------------------
# Whether background scheduled fleet scanning starts automatically on boot.
AGENT_FLEET_AUTO_SCAN_ENABLED=false

# Interval in minutes between scheduled background fleet scans (default: 60).
AGENT_FLEET_AUTO_SCAN_INTERVAL_MINUTES=60

# SSH connection timeout in seconds per host probe.
AGENT_FLEET_SSH_CONNECT_TIMEOUT=5
